# ─────────────────────────────────────────────────────────────────────────
# Voyago — environment configuration
#
# Two different runtimes read from this file:
#   - The Vite FRONTEND reads only the VITE_* variables. These get bundled
#     into the browser build, so never put a secret here — it would ship to
#     every visitor.
#   - NETLIFY FUNCTIONS (netlify/functions/*) read the rest. These run
#     server-side only (on Netlify's infrastructure, or under `netlify
#     dev`), and are the only place secrets belong.
#
# LOCAL DEVELOPMENT:
#   Copy this file to `.env` (git-ignored — `netlify dev` loads it
#   automatically into both the frontend and the functions). Also copy the
#   VITE_* section to `.env.local` if you run plain `vite` without Netlify
#   Dev for frontend-only work.
#   With VITE_USE_FIREBASE_EMULATORS=true and the two EMULATOR_HOST vars
#   set, nothing here needs to be real — the Firebase Local Emulator Suite
#   (Auth + Firestore) plus placeholder Cloudinary values are enough to run
#   the whole app, including create-booking and cancel-booking. Cloudinary
#   *signing* will work with placeholder values (it's just local HMAC
#   computation); actual uploads will be rejected by Cloudinary's real API
#   until you set real credentials — that failure is expected and handled
#   gracefully in the UI.
#   Run: `npm run emulators` (terminal 1), `npm run seed` (terminal 2, once),
#   then `npm run dev:netlify` (terminal 2). See README.md.
#
# PRODUCTION (Netlify):
#   Set the FRONTEND vars and the NETLIFY FUNCTIONS vars below as
#   environment variables in the Netlify dashboard (Site settings →
#   Environment variables) — never commit real values, and leave the two
#   *_EMULATOR_HOST vars unset in production.
# ─────────────────────────────────────────────────────────────────────────


# ───────────────────────── Frontend (Vite, public) ─────────────────────────
# Bundled into the browser build. Firebase's apiKey/appId/etc. are NOT
# secrets by design — Firebase's security model relies on Firestore/Auth
# rules, not on hiding these values. See
# https://firebase.google.com/docs/projects/api-keys

# From Firebase Console -> Project settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# "true" to connect to the local Firebase Emulator Suite instead of
# production Firebase. Strongly recommended for local development.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=localhost


# ────────────────────── Netlify Functions (server-side only) ──────────────
# Read by netlify/functions/*. NEVER prefix these with VITE_ — that would
# ship them to the browser.

# Firebase Admin SDK credentials — only needed against a REAL Firebase
# project (production). Firebase Console -> Project settings -> Service
# accounts -> Generate new private key, then copy these three fields out of
# the downloaded JSON. For local dev against the emulators, leave these
# three unset and use the *_EMULATOR_HOST vars below instead.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# Cloudinary credentials — cloudinary.com/console -> Dashboard.
# CLOUDINARY_API_SECRET must never reach the browser; it is only ever read
# here, by netlify/functions/cloudinary-sign.ts, to sign upload requests and
# perform deletes. The cloud name and API key are not secret (Cloudinary's
# own convention) — the signing function hands them to the browser at
# request time, so there's no VITE_CLOUDINARY_* variable at all.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Local development only: points the Netlify Functions' Firebase Admin SDK
# at the local emulators instead of requiring the credentials above. Leave
# UNSET in production (Netlify) — their mere presence switches the Admin
# SDK into emulator mode.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
